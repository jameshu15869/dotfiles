// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+shift+[",
    "command": "workbench.action.previousEditor"
  },
  {
    "key": "ctrl+shift+]",
    "command": "workbench.action.nextEditor"
  },
  {
    "key": "alt+w",
    "command": "workbench.action.closeActiveEditor"
  },
  {
    "key": "ctrl+x h",
    "command": "workbench.action.focusLeftGroup"
  },
  {
    "key": "ctrl+x j",
    "command": "workbench.action.focusBelowGroup"
  },
  {
    "key": "ctrl+x k",
    "command": "workbench.action.focusAboveGroup"
  },
  {
    "key": "ctrl+x l",
    "command": "workbench.action.focusRightGroup"
  },
  {
    "key": "ctrl+x shift-h",
    "command": "workbench.action.moveActiveEditorGroupLeft"
  },
  {
    "key": "ctrl+x shift-j",
    "command": "workbench.action.moveActiveEditorGroupDown"
  },
  {
    "key": "ctrl+x shift-k",
    "command": "workbench.action.moveActiveEditorGroupUp"
  },
  {
    "key": "ctrl+x shift-l",
    "command": "workbench.action.moveActiveEditorGroupRight"
  },
  {
    "key": "ctrl+x ctrl-x",
    "command": "workbench.action.focusNextGroup"
  },
  {
    "key": "ctrl+p",
    "when": "terminalFocus",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0010"
    }
  },
  {
    "key": "ctrl+e",
    "when": "terminalFocus",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0005"
    }
  },
  {
    "key": "ctrl+shift+backspace",
    "command": "workbench.action.tasks.runTask",
    "args": "Show Video"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n"
    },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+b",
    "command": "workbench.action.toggleSidebarVisibility"
  },
  {
    "key": "ctrl+'",
    "command": "workbench.view.extension.lisp-repl",
  },
  {
    "key": "ctrl+shift+'",
    "command": "alive.loadFile"
  },
  {
    "key": "shift+alt+i", "command": "editor.action.smartSelect.shrink", "when": "editorTextFocus"
  },
  {
    "key": "shift+alt+o", "command": "editor.action.smartSelect.expand", "when": "editorTextFocus"
  },
  {
    "key": "ctrl+x 1", "command": "workbench.action.closeEditorsInOtherGroups"
  }
]